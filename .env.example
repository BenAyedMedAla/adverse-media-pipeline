# Copy to .env and adjust. All values below are the defaults.

# Decision layer: gate probability below this is rejected as noise.
GATE_REJECT_THRESHOLD=0.50
# Decision layer: victim probability at or above this flags an edge case.
VICTIM_VETO_THRESHOLD=0.30
# Decision layer: keyword entailment probability at or above this adds a category.
TAG_THRESHOLD=0.50
# Maximum number of keyword categories returned per article.
TAG_MAX_LABELS=2

# Zero-shot NLI cross-encoder (Hugging Face model id) used by the decision layer.
NLI_MODEL_NAME=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7

# Any OpenAI-compatible endpoint (Groq, Gemini, OpenAI, Ollama). Groq by default.
LLM_BASE_URL=https://api.groq.com/openai/v1
# API key for the LLM endpoint. Leave empty to run without a generative LLM.
LLM_API_KEY=
# Model name served by the endpoint above. llama-3.1-8b-instant is not available on this Groq key.
LLM_MODEL=openai/gpt-oss-20b
# Reasoning setting for reasoning models only; remove it for other models.
LLM_REASONING_EFFORT=low
# Maximum concurrent LLM requests.
LLM_MAX_CONCURRENCY=4
# Per-request LLM timeout in seconds.
LLM_TIMEOUT_SECONDS=20
# Request JSON-object responses when the provider documents support.
LLM_JSON_MODE=true
# Maximum completion tokens, including reasoning tokens.
LLM_MAX_TOKENS=1024

# Optional Gemini OpenAI-compatible configuration:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=
# LLM_MODEL=<fill from Google AI Studio>
# LLM_JSON_MODE=false

# Per-source fetch timeout in seconds.
SOURCE_TIMEOUT_SECONDS=5
